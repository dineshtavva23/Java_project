<project name="ArbitraryArithmetic" default="compile" basedir=".">

    <property name="src1.dir" value="."/>
    <property name="src2.dir" value="arbitraryarithmetic"/>
    <property name="build.dir" value="build"/>

    <target name="init">
        <mkdir dir="${build.dir}"/>
    </target>


    <target name="compile" depends="init">
        <javac destdir="${build.dir}">
            <src path="${src1.dir}"/>
            <src path="${src2.dir}"/>
        </javac>
    </target>


    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

</project>
